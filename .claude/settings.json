{
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "allow": [
      "mcp__aret-memory__aret_boot",
      "mcp__aret-memory__aret_acknowledge_resume",
      "mcp__aret-memory__aret_get_front",
      "mcp__aret-memory__aret_update_front",
      "mcp__aret-memory__aret_replace_front",
      "mcp__aret-memory__aret_rebuild_front",
      "mcp__aret-memory__aret_prepare_handoff",
      "mcp__aret-memory__aret_get_resume_status",
      "mcp__aret-memory__aret_get_resume_brief",
      "mcp__aret-memory__aret_get_resume_protocol",
      "mcp__aret-memory__aret_find",
      "mcp__aret-memory__aret_read",
      "mcp__aret-memory__aret_read_batch",
      "mcp__aret-memory__aret_read_artifact",
      "mcp__aret-memory__aret_append_knowledge",
      "mcp__aret-memory__aret_add_relation",
      "mcp__aret-memory__aret_supersede_relation",
      "mcp__aret-memory__aret_get_related",
      "mcp__aret-memory__aret_attach_proof",
      "mcp__aret-memory__aret_record_proof",
      "mcp__aret-memory__aret_get_proofs",
      "mcp__aret-memory__aret_invalidate_proof",
      "mcp__aret-memory__aret_import_oracle_measurement",
      "mcp__aret-memory__aret_run_oracle",
      "mcp__aret-memory__aret_get_oracle_run",
      "mcp__aret-memory__aret_run_pipeline",
      "mcp__aret-memory__aret_get_pipeline_catalog",
      "mcp__aret-memory__aret_get_pipeline_runs",
      "mcp__aret-memory__aret_read_pipeline_artifact",
      "mcp__aret-memory__aret_register_component",
      "mcp__aret-memory__aret_register_function",
      "mcp__aret-memory__aret_register_brick",
      "mcp__aret-memory__aret_update_brick",
      "mcp__aret-memory__aret_register_asset",
      "mcp__aret-memory__aret_get_assets",
      "mcp__aret-memory__aret_get_forensics",
      "mcp__aret-memory__aret_get_roadmap",
      "mcp__aret-memory__aret_get_toolchain_status",
      "mcp__aret-memory__aret_sync_memory",
      "mcp__aret-memory__aret_rebuild_index",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__list_workflow_runs",
      "mcp__github__pull_request_read",
      "mcp__github__list_commits",
      "mcp__github__get_commit"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-pre-compact.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-sync-stop.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-resume-pre-tool.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__aret-memory__aret_acknowledge_resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-resume-post-tool.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-resume-stop.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/aret-mmu-sync-stop.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
